{
	"name": "starter",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"test": "tsx --test scripts/generator/*.test.ts scripts/images/*.test.ts src/lib/images/*.test.ts src/lib/templates/*.test.ts src/lib/server/*.test.ts",
		"test:routes": "tsx --test scripts/static-routes.test.ts",
		"dev": "npm run images && tsx scripts/generator/index.ts && vite dev",
		"build": "npm run images && tsx scripts/generator/index.ts && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"images": "tsx scripts/images/process.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.19.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"gray-matter": "^4.0.3",
		"marked": "^18.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"fuse.js": "^7.1.0",
		"sharp": "^0.35.5",
		"yaml": "^2.9.1"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
